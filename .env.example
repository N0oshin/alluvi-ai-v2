# Copy this file to .env and fill in the values. .env is git-ignored.
# Every variable the backend reads is listed here; src/config/index.ts validates them at start-up.

NODE_ENV=development
PORT=3000

# PostgreSQL on Supabase. Copy the "Session pooler" URI from the Connect button
# in the Supabase dashboard and put your database password in place of
# [YOUR-PASSWORD]. Check it with: npm run db:check
# Log detail: fatal, error, warn, info, debug, trace or silent. Optional.
# Defaults to debug in development, silent in test, info in production.
# LOG_LEVEL=info

DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# The database the automated tests use. Optional: when unset, tests that need
# a database are skipped. EVERY TABLE IN IT IS EMPTIED BEFORE EACH TEST. Until
# production exists it is the same Supabase project as DATABASE_URL (decided
# 2026-10-06); rows created by hand disappear at the next `npm test`. Before
# launch it moves to a separate project.
# TEST_DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Access token signing keys: a JSON array of private Ed25519 keys (JWK form,
# each with a "kid"). The FIRST key signs new tokens; every key in the list
# verifies. Make one with `npm run keys:generate` and paste the line inside the
# brackets. To rotate: generate a new key, put it first, and remove the old
# one 15 minutes later. Optional outside production: when unset the server
# makes a key at start-up, so tokens stop working at every restart. Required
# in production. Keep it secret, the "d" field is the private key.
# ACCESS_TOKEN_KEYS=[{"kid":"2026-10-08-ab12","kty":"OKP","crv":"Ed25519","x":"...","d":"..."}]

# The URL a magic link email points at; the token is added as ?token=...
# The app registers this URL as a Universal Link (iOS) / App Link (Android)
# so tapping it opens the app. Optional; the default is a placeholder.
# MAGIC_LINK_BASE_URL=https://app.alluvi.ai/auth/magic-link

# Sign in with Apple / Google: the client ids a token may be issued for,
# comma separated. Apple: the iOS bundle id (and the Services ID if the
# Android app uses Apple's web flow). Google: every OAuth client id (iOS,
# Android, web) from the Google Cloud console. Optional outside production:
# unset, POST /v1/auth/apple or /google answers 503. Required in production.
# APPLE_CLIENT_IDS=ai.alluvi.app
# GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com

# Universal Links / App Links, so tapping the magic link opens the app.
# Served at /.well-known/apple-app-site-association and
# /.well-known/assetlinks.json on the MAGIC_LINK_BASE_URL host. Each file
# answers 404 until its values are set.
# APPLE_TEAM_ID=A1B2C3D4E5              # Apple Developer > Membership
# IOS_BUNDLE_ID=ai.alluvi.app           # optional; defaults to the first APPLE_CLIENT_IDS entry
# ANDROID_PACKAGE_NAME=ai.alluvi.app
# ANDROID_CERT_SHA256=AA:BB:CC:...      # Play Console > App signing; comma separated for several

# External services. Each picks one implementation from src/providers/.
# "fake" needs no account and is the default outside production; it is
# refused in production. The real vendors arrive phase by phase.
# FOOD_VISION_PROVIDER=fake   # fake | snapcalorie | gemini
# EMAIL_PROVIDER=fake         # fake | resend
# With EMAIL_PROVIDER=resend, both of these are required. The API key comes
# from the Resend dashboard (API Keys). EMAIL_FROM is the From header and its
# domain must be verified in Resend (Domains: add the SPF, DKIM and DMARC
# records it shows to your DNS), or every send is refused with 403.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=Alluvi AI <hello@alluvi.ai>
# Bounce and complaint webhook: in Resend, Webhooks > Add, URL
# https://<your host>/webhooks/resend, events email.bounced and
# email.complained; paste its signing secret here. Optional until deployed.
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
# PUSH_PROVIDER=fake          # fake | fcm
# STORAGE_PROVIDER=fake       # fake | s3
